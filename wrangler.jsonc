{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mars-vrchat-gallery-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://vrchat.maao.cc"
  }
}
