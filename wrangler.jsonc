{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mars-vrchat-gallery-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "vrchat-statistics.marsinside.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": [
      "https://vrchat.maao.cc",
      "https://vrchat.marsinside.com"
    ]
  }
}
